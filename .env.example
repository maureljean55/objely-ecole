# Supabase project "objely-ecole" (Project Settings > API Keys). The borne only needs these two public values:
# it has no account, and reaches the database through the kiosk_* functions with its own pairing token.
NEXT_PUBLIC_SUPABASE_URL=https://jmmqgvtucavtvxwukgpw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Address the visitor's phone opens from the QR code of the photo step. Leave empty when the borne is served from a
# public address (Vercel). When running `next dev` on a Mac, put its Wi-Fi address, e.g. http://192.168.1.20:3000
NEXT_PUBLIC_SITE_URL=
